APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# The admin browser remains same-origin; Next proxies these API requests.
API_BASE_URL=http://localhost:8080
# The console's own origin, used for its same-origin checks.
PUBLIC_ADMIN_URL=http://localhost:3001
# The public site this console publishes to.
PUBLIC_WEB_URL=http://localhost:3000
# Shared with the public site so the console can ask it to drop caches
# after publishing. The console authenticates the operator on its own
# origin, then calls across server-to-server with this. Must match the
# public project's value and be at least 32 characters, or invalidation
# fails closed. Never exposed to a browser.
CACHE_INVALIDATION_SECRET=
# Powers the AI assist controls, which now live in this app.
ANTHROPIC_API_KEY=
