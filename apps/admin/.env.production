# Vercel / Next.js production environment for the standalone staff console.
# Keep database, authentication, payment, media, email, and MFA secrets on the
# API deployment; this app reaches that API through same-origin rewrites.

APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
APP_TIMEZONE=Africa/Accra

# Canonical origin for the standalone admin deployment.
PUBLIC_ADMIN_URL=https://admin.joekuntani.com

# Server-side rewrite target. Browser requests remain on the admin origin.
API_BASE_URL=https://api.joekuntani.com

# Optional browser monitoring. Configure these in Vercel when projects exist.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
RELEASE_VERSION=2026.08.08.0
