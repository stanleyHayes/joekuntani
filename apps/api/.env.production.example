# API production template — copy to apps/api/.env.production on the host/secret store.
# Never commit filled production values.

APP_ENV=production
APP_TIMEZONE=Africa/Accra
PUBLIC_WEB_URL=https://REPLACE_PUBLIC_HOST
API_BASE_URL=https://REPLACE_API_HOST
AUTH_TRUSTED_PROXY_CIDRS=REPLACE_PROXY_CIDRS

MONGODB_URI=REPLACE_ATLAS_URI
MONGODB_DATABASE=joe_kuntani_production

SESSION_SECRET=REPLACE_32+_BYTES
CSRF_SECRET=REPLACE_32+_BYTES
MFA_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTES
ENQUIRY_IP_HMAC_KEY=REPLACE_32+_BYTES
TICKET_TOKEN_HMAC_KEY=REPLACE_32+_BYTES
CRM_ATTACHMENT_HMAC_KEY=REPLACE_32+_BYTES

CLOUDINARY_CLOUD_NAME=REPLACE
CLOUDINARY_API_KEY=REPLACE
CLOUDINARY_API_SECRET=REPLACE
CLOUDINARY_WEBHOOK_SECRET=REPLACE
CLOUDINARY_FOLDER=joe-kuntani/production
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_DIMENSION=6000

RESEND_API_KEY=REPLACE
RESEND_FROM_EMAIL="Joe Kuntani <onboarding@resend.dev>"
RESEND_API_URL=https://api.resend.com/emails
INTERNAL_NOTIFICATION_EMAIL=REPLACE_STAFF_INBOX

POSTHOG_API_KEY=REPLACE
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=REPLACE
RELEASE_VERSION=REPLACE

PAYMENT_PROVIDER=REPLACE_AFTER_ADR004
PAYMENT_PROVIDER_SECRET=REPLACE
PAYMENT_WEBHOOK_SECRET=REPLACE
PAYMENT_RETURN_URL=https://REPLACE_PUBLIC_HOST/tickets/checkout

BOT_CHALLENGE_PROVIDER=REPLACE
BOT_CHALLENGE_SITE_KEY=REPLACE
BOT_CHALLENGE_SECRET_KEY=REPLACE
BOT_CHALLENGE_VERIFY_URL=REPLACE
ENQUIRY_TRUSTED_PROXY_CIDRS=REPLACE_PROXY_CIDRS
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW=1m
ENQUIRY_RATE_MAX_ENTRIES=10000
TICKET_HOLD_DURATION=10m

# Paystack — set the secret key to enable ticket checkout and donations.
# Without it the API fails closed: checkout returns 503 rather than accepting
# money it cannot capture. Webhook URL: POST /api/webhooks/payments/paystack
PAYSTACK_SECRET_KEY=
# Override only for sandboxes/mocks; defaults to https://api.paystack.co
PAYSTACK_API_BASE_URL=
# Currency donations are collected in (ISO 4217).
SUPPORT_CURRENCY=GHS
