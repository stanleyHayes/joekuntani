# API local template — copy to apps/api/.env and fill values.
# Never commit real secrets.

APP_ENV=local
APP_TIMEZONE=Africa/Accra
PUBLIC_WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
AUTH_TRUSTED_PROXY_CIDRS=

# Prefer a replica set locally for transactions (example: jk-rs-mongo on 27027)
MONGODB_URI="mongodb://127.0.0.1:27027/?replicaSet=rs0&directConnection=true"
MONGODB_DATABASE=joe_kuntani_local

SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
ENQUIRY_IP_HMAC_KEY=replace-with-at-least-32-random-bytes
TICKET_TOKEN_HMAC_KEY=replace-with-at-least-32-random-bytes
CRM_ATTACHMENT_HMAC_KEY=replace-with-at-least-32-random-bytes

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WEBHOOK_SECRET=
CLOUDINARY_FOLDER=joe-kuntani/local
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_DIMENSION=6000

RESEND_API_KEY=
RESEND_FROM_EMAIL="Joe Kuntani <info@joekuntani.com>"
RESEND_API_URL=https://api.resend.com/emails
INTERNAL_NOTIFICATION_EMAIL=booking@joekuntani.com

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
RELEASE_VERSION=

PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
# https required in staging/production; http allowed only for localhost/127.0.0.1
PAYMENT_RETURN_URL=http://localhost:3000/tickets/checkout

BOT_CHALLENGE_PROVIDER=
BOT_CHALLENGE_SITE_KEY=
BOT_CHALLENGE_SECRET_KEY=
BOT_CHALLENGE_VERIFY_URL=
ENQUIRY_TRUSTED_PROXY_CIDRS=
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW=1m
ENQUIRY_RATE_MAX_ENTRIES=10000
TICKET_HOLD_DURATION=10m

# Staff provisioning (go run ./cmd/adminuser) — local only
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_ROLE=administrator
STAFF_MFA_SECRET=

# Paystack — set the secret key to enable ticket checkout and donations.
# Without it the API fails closed: checkout returns 503 rather than accepting
# money it cannot capture. Webhook URL: POST /api/webhooks/payments/paystack
PAYSTACK_SECRET_KEY=
# Override only for sandboxes/mocks; defaults to https://api.paystack.co
PAYSTACK_API_BASE_URL=
# Currency donations are collected in (ISO 4217).
SUPPORT_CURRENCY=GHS
