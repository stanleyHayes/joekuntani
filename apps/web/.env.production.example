# Web production template — copy to apps/web/.env.production on the host/secret store.

APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
APP_TIMEZONE=Africa/Accra
PUBLIC_WEB_URL=https://REPLACE_PUBLIC_HOST
API_BASE_URL=https://REPLACE_API_HOST
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_API_HOST

# Keep demo fixtures off in production
NEXT_PUBLIC_DEMO_CONTENT=0

NEXT_PUBLIC_POSTHOG_KEY=REPLACE
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=REPLACE
SENTRY_DSN=REPLACE
RELEASE_VERSION=REPLACE

BOT_CHALLENGE_SITE_KEY=REPLACE
NEXT_PUBLIC_BOT_CHALLENGE_SITE_KEY=REPLACE
