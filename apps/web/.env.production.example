# Web production template — paste into Vercel Project → Settings → Environment Variables.
# Do NOT put Mongo, Cloudinary, Resend, MFA, or Paystack secrets here — those stay on Render.

APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
APP_TIMEZONE=Africa/Accra
PUBLIC_WEB_URL=https://REPLACE_VERCEL_HOST
API_BASE_URL=https://api.joekuntani.com
NEXT_PUBLIC_API_BASE_URL=https://api.joekuntani.com

# Demo fixtures are placeholder copy, never approved production inventory.
# Only "1" or "true" enables them; production must leave this at 0.
NEXT_PUBLIC_DEMO_CONTENT=0

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
RELEASE_VERSION=2026.08.06.0

BOT_CHALLENGE_SITE_KEY=
NEXT_PUBLIC_BOT_CHALLENGE_SITE_KEY=

# Copy assistant for admin long-text fields (Anthropic Messages API).
# Leave blank to disable the AI bar; the route returns 503 and the UI degrades.

# Buyer help address shown on ticket and order confirmations.
NEXT_PUBLIC_SUPPORT_EMAIL=support@joekuntani.com
# Set to send /admin to the standalone console. Unset serves nothing
# there, since the console no longer lives in this app.
PUBLIC_ADMIN_URL=https://REPLACE_ADMIN_HOST
# Shared with the public site so the console can ask it to drop caches
# after publishing. The console authenticates the operator on its own
# origin, then calls across server-to-server with this. Must match the
# public project's value and be at least 32 characters, or invalidation
# fails closed. Never exposed to a browser.
CACHE_INVALIDATION_SECRET=
