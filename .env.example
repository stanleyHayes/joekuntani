# Deployment notes (JK-017)
# Staging/production require PUBLIC_WEB_URL (https), MFA_ENCRYPTION_KEY,
# TICKET_TOKEN_HMAC_KEY, ENQUIRY_IP_HMAC_KEY, and environment-isolated
# MONGODB_DATABASE / CLOUDINARY_FOLDER values. See docs/runbooks/deployment.md.

# Environment identity
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
APP_TIMEZONE=Africa/Accra
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Empty means never trust it.
AUTH_TRUSTED_PROXY_CIDRS=
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# MongoDB - use isolated databases per environment
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=joe_kuntani_local

# Authentication placeholders; generate unique secrets locally
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
# Base64 without padding; decodes to exactly 32 random bytes. Never expose client-side.
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WEBHOOK_SECRET=
CLOUDINARY_FOLDER=joe-kuntani/local
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_DIMENSION=6000

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Joe Kuntani <info@joekuntani.com>"
RESEND_API_URL=https://api.resend.com/emails
INTERNAL_NOTIFICATION_EMAIL=booking@joekuntani.com

# Analytics and monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
RELEASE_VERSION=

# Payment provider remains vendor-neutral until ADR-004 is decided
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Anti-spam provider remains open until DISC-002
BOT_CHALLENGE_PROVIDER=
BOT_CHALLENGE_SITE_KEY=
BOT_CHALLENGE_SECRET_KEY=
BOT_CHALLENGE_VERIFY_URL=
ENQUIRY_IP_HMAC_KEY=replace-with-at-least-32-random-bytes
ENQUIRY_TRUSTED_PROXY_CIDRS=
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW=1m
ENQUIRY_RATE_MAX_ENTRIES=10000
TICKET_HOLD_DURATION=10m
TICKET_TOKEN_HMAC_KEY=replace-with-at-least-32-random-bytes
CRM_ATTACHMENT_HMAC_KEY=replace-with-at-least-32-random-bytes
PAYMENT_PROVIDER=
PAYMENT_RETURN_URL=https://example.com

# Copy assistant for the admin long-text fields (Anthropic Messages API).
# Server-side only — never expose as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=

# Buyer help address shown on ticket and order confirmations.
NEXT_PUBLIC_SUPPORT_EMAIL=support@joekuntani.com
